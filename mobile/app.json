{
  "expo": {
    "name": "PayPulse AI",
    "slug": "paypulse-mobile",
    "version": "2.6.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4F7F6"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ai.heftin.paypulse",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "PayPulse accesses your photo library to attach receipt documents to corporate expense claims."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F4F7F6"
      },
      "package": "ai.heftin.paypulse",
      "versionCode": 106,
      "permissions": []
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "name": "PayPulse AI",
      "shortName": "PayPulse",
      "description": "Employee pay, earned wage access, and expense benefits in one workspace.",
      "display": "standalone",
      "startUrl": "/",
      "scope": "/",
      "themeColor": "#18364B",
      "backgroundColor": "#F4F1E9"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow PayPulse to select receipt images for expense claims.",
          "cameraPermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "729b8720-94e1-4c12-a1b7-e2348a19d84e"
      },
      "apiUrl": "https://paypulse-api-three.vercel.app/api",
      "environment": "production"
    }
  }
}

