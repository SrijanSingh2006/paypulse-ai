{
  "expo": {
    "name": "PayPulse AI",
    "slug": "paypulse-mobile",
    "version": "2.4.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4F7F6"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ai.heftin.paypulse",
      "infoPlist": {
        "NSCameraUsageDescription": "PayPulse uses your camera to scan and upload receipt invoices for HR expense reimbursements.",
        "NSPhotoLibraryUsageDescription": "PayPulse accesses your photo library to attach receipt documents to corporate expense claims.",
        "NSFaceIDUsageDescription": "PayPulse uses Face ID to securely authenticate and disburse on-demand salary advances."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F4F7F6"
      },
      "package": "ai.heftin.paypulse",
      "versionCode": 104,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow PayPulse to access your receipts library."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "729b8720-94e1-4c12-a1b7-e2348a19d84e"
      },
      "apiUrl": "http://10.0.2.2:4000/api",
      "environment": "production"
    }
  }
}

